# Performance
font-size = 10
hint-font = false
late-keyboard-init = true
ascii-input = true

# Style & Layout
text-color = #dddddd
selection-color = #c9b58e
prompt-text = "run: "
horizontal = true
result-spacing = 12
num-results = 5

# Window
width = 256
height = 40
outline-width = 0
border-width = 1
border-color = #444444
corner-radius = 8
padding-top = 8
padding-bottom = 8
padding-left = 10
padding-right = 10

# Position
anchor = bottom
margin-bottom = 24
exclusive-zone = -1

# Behavior
hide-cursor = true
history = false
matching-algorithm = normal
require-match = true
physical-keybindings = true
